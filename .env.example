# Notion API Credentials
NOTION_TOKEN=secret_your_notion_integration_token_here
NOTION_DATABASE_ID=your_notion_tasks_database_id_here
NOTION_TASKS_DB_ID=your_notion_tasks_database_id_here
NOTION_SUBSTACK_ID=your_notion_substack_database_id_here
NOTION_RAMBLINGS_ID=your_notion_ramblings_database_id_here
NOTION_DAILY_LOGS_ID=your_notion_daily_logs_database_id_here
NOTION_SUBJECTS_DB_ID=your_notion_subjects_database_id_here
NOTION_RESOURCES_DB_ID=your_notion_resources_database_id_here

# Telegram Bot Credentials
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz_example
TELEGRAM_CHAT_ID=123456789

# WhatsApp Cloud API Credentials
WHATSAPP_TOKEN=your_whatsapp_bearer_token_here
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id_here
WHATSAPP_VERIFY_TOKEN=your_whatsapp_webhook_verify_token_here

# Application Settings
APP_ENV=development
PORT=8000
WEBHOOK_SECRET=your_optional_webhook_secret

# Gemini API Credentials (required for intent classification)
GEMINI_API_KEY=your_gemini_api_key_here

